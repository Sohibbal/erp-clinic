// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  KASIR
  APOTEKER
}

enum EmployeeRole {
  DOCTOR
  PHARMACIST
  RECEPTIONIST
  THERAPIST
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum Gender {
  MALE
  FEMALE
}

enum PatientStatus {
  NEW_PATIENT
  RETURNING
}

enum QueueStatus {
  WAITING
  IN_ROOM
  DONE
  CANCELLED
}

enum PaymentMethod {
  QRIS
  TRANSFER
  CASH
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum TransactionType {
  CLINIC_SERVICE
  RETAIL
}

enum TransactionItemType {
  SERVICE
  PRODUCT
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  EXPIRING
  OUT_OF_STOCK
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  EXPIRED
  USAGE
}

// ============================================================
// MODELS
// ============================================================

/// Profil klinik — single-clinic setup
model Clinic {
  id            String   @id @default(uuid())
  name          String
  address       String?
  phone         String?
  email         String?
  licenseNumber String?  @map("license_number")

  operatingHours OperatingHours[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinics")
}

/// Jam operasional klinik per hari
model OperatingHours {
  id        String  @id @default(uuid())
  clinicId  String  @map("clinic_id")
  dayOfWeek String  @map("day_of_week") // Senin, Selasa, etc.
  openTime  String  @map("open_time") // "09:00"
  closeTime String  @map("close_time") // "18:00"
  isOpen    Boolean @default(true) @map("is_open")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("operating_hours")
}

/// Akun login sistem (kasir, apoteker, owner)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")

  employeeId String?   @unique @map("employee_id")
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  transactions Transaction[] @relation("CashierTransactions")
  auditLogs    AuditLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Data karyawan (dokter, apoteker, resepsionis, terapis)
model Employee {
  id        String         @id @default(uuid())
  name      String
  role      EmployeeRole
  specialty String?
  status    EmployeeStatus @default(ACTIVE)
  joinDate  DateTime?      @map("join_date")
  phone     String?
  imageUrl  String?        @map("image_url")

  user            User?
  medicalRecords  MedicalRecord[]  @relation("DoctorRecords")
  therapistRecords MedicalRecord[] @relation("TherapistRecords")
  doctorQueues    Queue[]          @relation("DoctorQueues")
  therapistQueues Queue[]          @relation("TherapistQueues")
  stockMovements  StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("employees")
}

/// Data pasien lengkap
model Patient {
  id           String        @id @default(uuid())
  noRM         String        @unique @map("no_rm")
  nik          String?       @unique
  name         String
  gender       Gender
  phone        String?
  dateOfBirth  DateTime?     @map("date_of_birth")
  allergies    String?
  guardianName String?       @map("guardian_name")
  occupation   String?
  address      String?
  status       PatientStatus @default(NEW_PATIENT)

  medicalRecords MedicalRecord[]
  queues         Queue[]
  transactions   Transaction[]

  registeredAt DateTime @default(now()) @map("registered_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("patients")
}

/// Rekam medis per kunjungan
model MedicalRecord {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  doctorId    String?  @map("doctor_id")
  therapistId String?  @map("therapist_id")
  visitDate   DateTime @default(now()) @map("visit_date")

  anamnesis String? @db.Text // Pemeriksaan fisik
  diagnosis String? @db.Text
  treatment String? @db.Text // Terapi
  notes     String? @db.Text

  transactionId String? @map("transaction_id")

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Employee?    @relation("DoctorRecords", fields: [doctorId], references: [id], onDelete: SetNull)
  therapist   Employee?    @relation("TherapistRecords", fields: [therapistId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
  @@map("medical_records")
}

/// Katalog layanan klinik
model Service {
  id        String  @id @default(uuid())
  name      String
  description String? @db.Text
  basePrice Decimal @map("base_price") @db.Decimal(12, 2)
  isActive  Boolean @default(true) @map("is_active")

  doctorFeeType     DiscountType? @map("doctor_fee_type")
  doctorFeeValue    Decimal?      @default(0) @map("doctor_fee_value") @db.Decimal(12, 2)
  therapistFeeType  DiscountType? @map("therapist_fee_type")
  therapistFeeValue Decimal?      @default(0) @map("therapist_fee_value") @db.Decimal(12, 2)

  linkedProducts   ServiceProduct[]
  promotions       Promotion[]
  transactionItems TransactionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("services")
}

/// Pemetaan produk ke layanan (many-to-many)
model ServiceProduct {
  id               String  @id @default(uuid())
  serviceId        String  @map("service_id")
  productId        String  @map("product_id")
  defaultQty       Int     @default(1) @map("default_qty")
  description      String?
  isDefaultChecked Boolean @default(false) @map("is_default_checked")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
  @@map("service_products")
}

/// Promo khusus per layanan
model Promotion {
  id            String       @id @default(uuid())
  serviceId     String       @map("service_id")
  isActive      Boolean      @default(false) @map("is_active")
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  startDate     DateTime?    @map("start_date")
  endDate       DateTime?    @map("end_date")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([serviceId, isActive])
  @@map("promotions")
}

/// Katalog produk / obat (inventory)
model Product {
  id          String      @id @default(uuid())
  name        String
  category    String
  stock       Int         @default(0)
  price       Decimal     @db.Decimal(12, 2)
  stockStatus StockStatus @default(IN_STOCK) @map("stock_status")
  icon        String?
  batchNo     String?     @map("batch_no")
  lastRestock DateTime?   @map("last_restock")
  expiryDate  DateTime?   @map("expiry_date")

  serviceProducts  ServiceProduct[]
  stockMovements   StockMovement[]
  transactionItems TransactionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([stockStatus])
  @@map("products")
}

/// Audit trail pergerakan stok
model StockMovement {
  id            String            @id @default(uuid())
  productId     String            @map("product_id")
  performedById String?           @map("performed_by_id")
  movementType  StockMovementType @map("movement_type")
  quantity      Int
  stockBefore   Int               @map("stock_before")
  stockAfter    Int               @map("stock_after")
  referenceNote String?           @map("reference_note")

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  performedBy Employee? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

/// Antrean pasien harian
model Queue {
  id            String      @id @default(uuid())
  patientId     String      @map("patient_id")
  doctorId      String?     @map("doctor_id")
  therapistId   String?     @map("therapist_id")
  serviceName   String?     @map("service_name")
  status        QueueStatus @default(WAITING)
  queueNumber   Int         @map("queue_number")
  estimatedTime String?     @map("estimated_time")
  queueDate     DateTime    @default(now()) @map("queue_date") @db.Date

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    Employee? @relation("DoctorQueues", fields: [doctorId], references: [id], onDelete: SetNull)
  therapist Employee? @relation("TherapistQueues", fields: [therapistId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([queueDate, status])
  @@map("queues")
}

/// Transaksi pembayaran (klinik & retail)
model Transaction {
  id              String            @id @default(uuid())
  invoiceId       String            @unique @map("invoice_id")
  patientId       String?           @map("patient_id") // null untuk retail
  cashierId       String?           @map("cashier_id")
  transactionType TransactionType   @default(CLINIC_SERVICE) @map("transaction_type")
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal           @default(0) @map("total_amount") @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?    @map("payment_method")
  status          TransactionStatus @default(PENDING)
  notes           String?           @db.Text

  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  cashier User?    @relation("CashierTransactions", fields: [cashierId], references: [id], onDelete: SetNull)

  items          TransactionItem[]
  medicalRecords MedicalRecord[]

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@index([patientId])
  @@map("transactions")
}

/// Detail item per transaksi
model TransactionItem {
  id            String              @id @default(uuid())
  transactionId String              @map("transaction_id")
  serviceId     String?             @map("service_id")
  productId     String?             @map("product_id")
  itemType      TransactionItemType @map("item_type")
  itemName      String              @map("item_name")
  quantity      Int                 @default(1)
  unitPrice     Decimal             @map("unit_price") @db.Decimal(12, 2)
  subtotal      Decimal             @db.Decimal(12, 2)
  doctorFee     Decimal?            @map("doctor_fee") @db.Decimal(12, 2)
  therapistFee  Decimal?            @map("therapist_fee") @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@map("transaction_items")
}

/// Audit log untuk semua perubahan penting di sistem
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entityType String   @map("entity_type") // Patient, Transaction, MedicalRecord, etc.
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value") @db.Text // JSON snapshot sebelum perubahan
  newValue   String?  @map("new_value") @db.Text // JSON snapshot setelah perubahan
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
